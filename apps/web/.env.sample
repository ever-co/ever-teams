# Local development env (copy to apps/web/.env.local). The Docker image reads the same variables at RUNTIME
# (NEXT_PUBLIC_* and branding included, nothing is baked at build time): see /.env.docker for that reference.

RECOIL_DUPLICATE_ATOM_KEY_CHECKING_ENABLED=false

# Gauzy API ORIGIN, without a trailing /api: the app appends /api itself
GAUZY_API_SERVER_URL=https://api.ever.team
NEXT_PUBLIC_GAUZY_API_SERVER_URL=https://api.ever.team
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Logs Configuration
LOG_FOLDER_MAX_SIZE=10
NEXT_PUBLIC_LOG_FOLDER_MAX_SIZE=10 ## in Mb
ACTIVE_LOCAL_LOG_SYSTEM=true
NEXT_PUBLIC_ACTIVE_LOCAL_LOG_SYSTEM=true

# Next Auth configs
AUTH_SECRET=ever-app-auth-secret

# Social login: a sign-in button exists only for Google, Facebook, GitHub and Twitter/X, and it is shown only
# when BOTH NEXT_PUBLIC_<PROVIDER>_APP_NAME is set (any value; an empty value counts as set, and the Docker image
# sets the GOOGLE, FACEBOOK, GITHUB and TWITTER app names to empty) AND <PROVIDER>_CLIENT_ID / _CLIENT_SECRET are
# set. The app name is not displayed; demo mode (NEXT_PUBLIC_DEMO=true) hides the buttons.

# Google OAuth configuration
NEXT_PUBLIC_GOOGLE_APP_NAME=ever-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Github OAuth configuration
NEXT_PUBLIC_GITHUB_APP_NAME=ever-github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Facebook OAuth configuration
NEXT_PUBLIC_FACEBOOK_APP_NAME=ever-facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Twitter OAuth configuration
NEXT_PUBLIC_TWITTER_APP_NAME=ever-twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Other OAuth providers: next-auth accepts these credentials (with the NEXT_PUBLIC_<PROVIDER>_APP_NAME set)
# and serves /api/auth/callback/<provider id>, but the sign-in page has NO button for them, and the Gauzy API
# verifies google / github / facebook / twitter tokens only, so finishing their flow ends in
# "Unsupported provider". Ever Teams cannot lift that on its own: see ever-co/ever-gauzy ProviderEnum.
# NEXT_PUBLIC_APPLE_APP_NAME=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=
# NEXT_PUBLIC_DISCORD_APP_NAME=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# NEXT_PUBLIC_LINKEDIN_APP_NAME=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# Microsoft Entra ID (formerly Azure AD), provider id microsoft-entra-id. MICROSOFT_TENANT_ID is required for
# a single-tenant app registration; leave it unset for a multi-tenant one ('common').
# NEXT_PUBLIC_MICROSOFT_APP_NAME=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=
# NEXT_PUBLIC_SLACK_APP_NAME=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=

# CAPTCHA Settings
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Invite Callback URL (empty = this app's origin + /auth/accept-invite). Only set it to override:
# a value here wins for every invitation email, e.g. https://app.ever.team/auth/accept-invite
INVITE_CALLBACK_URL=

# Verify Email Callback URL (empty = this app's origin + /verify-email), e.g. https://app.ever.team/verify-email
VERIFY_EMAIL_CALLBACK_URL=

# SMTP Mail Configuration
SMTP_FROM_ADDRESS=noreply@ever.team
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USERNAME=
SMTP_PASSWORD=

# App Defaults
APP_NAME="Ever Teams"
APP_SLOGAN_TEXT="Real-Time Clarity, Real-Time Reality™."
APP_LINK="https://ever.team"
APP_SIGNATURE="Ever Teams"
APP_LOGO_URL="https://app.ever.team/assets/ever-teams.png"

# Site Metadata (for SEO and branding)
NEXT_PUBLIC_SITE_NAME="Ever Teams"
NEXT_PUBLIC_SITE_TITLE="Open Work and Project Management Platform"
NEXT_PUBLIC_SITE_DESCRIPTION="All-In-One Work & Workforce Management, Time Management, Time Tracking, Activity Tracking, Productivity Tracking & Metrics, Projects / Tasks & Issues Management, Organizations & Teams, Integrations (GitHub, JIRA, ...) and More!"
NEXT_PUBLIC_SITE_KEYWORDS="time tracking, open-work, project management, software development, task management, team collaboration, agile, kanban, scrum, gantt chart, resource management, project management, work items tracking, agile, scrum, collaboration"
NEXT_PUBLIC_WEB_APP_URL="https://app.ever.team"
NEXT_PUBLIC_TWITTER_USERNAME="ever-teams"

# Images Configuration (comma-separated list of allowed image domains)
# At build time this is the next/image optimizer allowlist; at runtime (Docker) extra hosts are also allowed,
# served without optimization.
NEXT_PUBLIC_IMAGES_HOSTS="dummyimage.com,res.cloudinary.com,gauzy.sfo2.digitaloceanspaces.com,cdn-icons-png.flaticon.com,api.gauzy.co,apida.gauzy.co,apicw.gauzy.co,apicivo.gauzy.co,apidev.gauzy.co,apidemo.gauzy.co,apidemocw.gauzy.co,apidemodt.gauzy.co,apidemodts.gauzy.co,apidemocivo.gauzy.co,apidemoda.gauzy.co,apistage.gauzy.co,apistagecivo.gauzy.co,apistagecw.gauzy.co,apistageda.gauzy.co,apistagedt.gauzy.co,apistagedts.gauzy.co,api.ever.team,app.ever.team,apidev.ever.team,gauzy.s3.wasabisys.com,gauzystage.s3.wasabisys.com"

# Company
COMPANY_NAME="Ever Co. LTD"
COMPANY_LINK="https://ever.co"
TERMS_LINK="https://ever.team/tos"
PRIVACY_POLICY_LINK="https://ever.team/privacy"

#Main picture
MAIN_PICTURE='/assets/cover/auth-bg-cover.png'
MAIN_PICTURE_DARK='/assets/cover/auth-bg-cover-dark.png'

# Cookies
NEXT_PUBLIC_COOKIE_DOMAINS=ever.team

# SENTRY
SENTRY_ORG=ever-co
SENTRY_PROJECT=ever-teams-web
SENTRY_LOG_LEVEL=info # info|debug
SENTRY_AUTH_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DEBUG=false # true/false

# Jitsu
NEXT_PUBLIC_JITSU_BROWSER_URL=
NEXT_PUBLIC_JITSU_BROWSER_WRITE_KEY=
# NEXT_PUBLIC_JITSU_COOKIE_DOMAIN=

# Meet
NEXT_PUBLIC_MEET_DOMAIN=meet.ever.team
NEXT_PUBLIC_BOARD_BACKEND_POST_URL=https://jsonboard.ever.team/api/v2/post/

# Private Variables (Meet)
MEET_JWT_APP_ID=ever_teams
MEET_JWT_APP_SECRET=

# Warning: IF TRUE This allows production builds to successfully complete even if
# your project has ESLint errors.
NEXT_IGNORE_ESLINT_ERROR_ON_BUILD=true

# Mailchimp
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=
ANALYZE=false

POSTMARK_SERVER_API_TOKEN=

# Application Configuration
NEXT_PUBLIC_DEMO=
IS_DESKTOP_APP=

# Analytics & Tracking
JITSU_SERVER_URL=
JITSU_SERVER_WRITE_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_KEY=

# Video Conferencing & Communication
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
# Video meetings provider: 'Jitsi' (default) or 'LiveKit' (case-insensitive)
NEXT_PUBLIC_MEET_TYPE=
NEXT_PUBLIC_CHATWOOT_API_KEY=
# Chatwoot origin, for a self-hosted Chatwoot (default: https://app.chatwoot.com)
# NEXT_PUBLIC_CHATWOOT_BASE_URL=

# Board & Collaboration Features
NEXT_PUBLIC_BOARD_APP_DOMAIN=
NEXT_PUBLIC_BOARD_FIREBASE_CONFIG=

# UI & Performance
# Captcha provider: recaptcha (default), hcaptcha or cloudflare (Turnstile)
NEXT_PUBLIC_CAPTCHA_TYPE=
NEXT_PUBLIC_DISABLE_AUTO_REFRESH=
# Show the Inbox entry in the sidebar (the /inbox page does not exist yet)
# NEXT_PUBLIC_INBOX_ENABLED=false
