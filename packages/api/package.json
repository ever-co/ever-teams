{
	"name": "@ever-teams/api",
	"version": "0.2.0",
	"main": "dist/index.cjs",
	"types": "dist/index.d.ts",
	"type": "module",
	"license": "MIT",
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.es.js"
			},
			"require": {
				"types": "./dist/cjs/index.d.ts",
				"default": "./dist/index.cjs"
			},
			"default": "./dist/index.es.js"
		}
	},
	"scripts": {
		"build": " rollup -c",
		"test": "yarn --cwd ../toolkit-types build && rollup -c && node --test test/*.test.mjs"
	},
	"dependencies": {
		"@ever-teams/toolkit-types": "^0.1.10",
		"qs": "^6.15.2"
	},
	"devDependencies": {
		"@ever-teams/ts-config": "*",
		"@rollup/plugin-commonjs": "^28.0.1",
		"@rollup/plugin-node-resolve": "^15.3.0",
		"@rollup/plugin-terser": "^0.4.4",
		"@rollup/plugin-typescript": "^12.1.1",
		"rollup": "^4.59.0",
		"typescript": "^5.6.3"
	},
	"module": "dist/index.es.js"
}
