# Docker Compose sample .env file for Production

# Runtime variables of the webapp container: see .env.docker for the full list (all read at runtime, the image
# bakes none of them). Variables listed under `environment:` in docker-compose.demo.yml take precedence over this
# file: to change one of those, export it in your shell or pass `--env-file <file>` to docker-compose.

NODE_ENV=production

# set true if running inside Docker container
IS_DOCKER=true
