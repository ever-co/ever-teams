# ============================================
# DOCKER ENVIRONMENT VARIABLES FOR EVER-TEAMS-WEBAPP
# ============================================
# RUNTIME configuration of the prebuilt image (everco/ever-teams-webapp, ghcr.io/ever-co/ever-teams-webapp and
# their -stage / -dev variants). The image bakes nothing deployment-specific: every variable below, including all
# NEXT_PUBLIC_* and branding variables, is read from the container environment at runtime (when the server starts
# and on every page request), except the ones marked as not read (build-time only or unused, mostly in the last
# section). Change a value and restart the container; no rebuild is needed.
#
# Usage:
#   docker run --env-file .env.docker -p 3030:3030 everco/ever-teams-webapp
#   ./docker-run.sh start   (docker-compose -f docker-compose.build.yml --env-file .env.docker)
#
# Rules:
# - An empty value means "unset": the app's built-in default applies. It also replaces a default the image sets
#   (e.g. NEXT_PUBLIC_DEMO=true on the -dev image), so delete a line rather than emptying it to keep that default.
#   Exception: an empty NEXT_PUBLIC_<PROVIDER>_APP_NAME still counts as set (see SOCIAL LOGIN below).
# - Keep comments on their own line: `docker run --env-file` does not strip inline comments or quotes.
# - NEXT_PUBLIC_* and branding values are sent to the browser: never put a secret in them.
# - The sample values below are NOT secrets; replace AUTH_SECRET before any real deployment.
# - Services that Ever operates for its own deployments (Jitsi meetings, whiteboard, GitHub App) are OFF by default
#   here: each one is shown commented out as "(Ever-operated: ...)"; point it at your own service to enable it.

# ============================================
# REQUIRED FOR YOUR OWN DEPLOYMENT
# ============================================
# Gauzy API origin for the Next.js server, without a trailing /api (the app appends it); must be reachable
# from inside the container
GAUZY_API_SERVER_URL=https://api.ever.team
# Gauzy API origin for the browser; unset = the browser calls the API through this app's /api proxy
NEXT_PUBLIC_GAUZY_API_SERVER_URL=https://api.ever.team

# To use a local API, uncomment these lines (inside a container, localhost is the container itself:
# use the API service name, e.g. http://api:3000, for GAUZY_API_SERVER_URL):
# GAUZY_API_SERVER_URL=http://localhost:3000
# NEXT_PUBLIC_GAUZY_API_SERVER_URL=http://localhost:3000

# NextAuth secret (sessions, social login). REQUIRED in production and deliberately EMPTY here: generate
# your own and never reuse a published value, e.g.  AUTH_SECRET=$(openssl rand -base64 32)
AUTH_SECRET=

# ============================================
# OPTIONAL - BASE CONFIGURATION
# ============================================
# Node environment of the server
NODE_ENV=production
# Informational flag, already set by the image
IS_DOCKER=true
# Port mapping used by the docker-compose files (the server itself listens on PORT, default 3030)
UI_PORT=3030
# Port the server listens on inside the container (default: 3030, set by the image)
# PORT=3030

# ============================================
# OPTIONAL - BRANDING (sent to the browser)
# ============================================
# The value none hides APP_SLOGAN_TEXT, COMPANY_LINK, TERMS_LINK and PRIVACY_POLICY_LINK (an empty value brings
# back the default instead).
# Product name shown in the UI and emails (default: Ever Teams)
APP_NAME=Ever Teams
# Slogan shown on the auth pages (default: Real-Time Clarity, Real-Time Reality™.; none = no slogan)
APP_SLOGAN_TEXT=Real-Time Clarity, Real-Time Reality™.
# Public URL of your app, used in links (default: https://app.ever.team)
APP_LINK=https://app.ever.team
# Signature used in emails (default: Ever Teams)
APP_SIGNATURE=Ever Teams
# Logo: an absolute URL or a path served by this app; emails get a path resolved against APP_LINK
# (default: /assets/ever-teams.png, i.e. https://app.ever.team/assets/ever-teams.png with the default APP_LINK)
APP_LOGO_URL=/assets/ever-teams.png
# Favicon URL, absolute or a path served by this app (default: /favicon.ico, the Ever Teams icon)
# APP_FAVICON_URL=https://teams.example.com/favicon.ico

# ============================================
# OPTIONAL - COMPANY INFORMATION (sent to the browser)
# ============================================
# Company name shown in the footer (default: Ever Co. LTD)
COMPANY_NAME=Ever Co. LTD
# Company website (default: https://ever.co; none = no company link)
COMPANY_LINK=https://ever.co
# Terms of service URL (default: https://ever.team/tos; none = no terms link)
TERMS_LINK=https://ever.team/tos
# Privacy policy URL (default: https://ever.team/privacy; none = no privacy policy link)
PRIVACY_POLICY_LINK=https://ever.team/privacy

# ============================================
# OPTIONAL - MAIN PICTURES (sent to the browser)
# ============================================
# Auth page illustration, light theme
MAIN_PICTURE=/assets/cover/auth-bg-cover.png
# Auth page illustration, dark theme
MAIN_PICTURE_DARK=/assets/cover/auth-bg-cover-dark.png

# ============================================
# OPTIONAL - SITE METADATA (SEO)
# ============================================
# Reserved for SEO metadata: the pages do not render the four NEXT_PUBLIC_SITE_* values or the Twitter handle yet
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_TITLE=
NEXT_PUBLIC_SITE_DESCRIPTION=
NEXT_PUBLIC_SITE_KEYWORDS=
# Public URL of the web app (used by the /api/health check)
NEXT_PUBLIC_WEB_APP_URL=
NEXT_PUBLIC_TWITTER_USERNAME=

# ============================================
# OPTIONAL - CAPTCHA SETTINGS (signup)
# ============================================
# Set the site key and the secret together, or leave both empty to sign up without a captcha.
# Public site key of the captcha widget
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
# Server-side secret used to verify the captcha token
CAPTCHA_SECRET_KEY=
# Captcha provider: recaptcha (default), hcaptcha or cloudflare (Turnstile)
NEXT_PUBLIC_CAPTCHA_TYPE=

# ============================================
# OPTIONAL - IMAGE HOSTS
# ============================================
# Extra remote image hosts, comma-separated (the origins of NEXT_PUBLIC_GAUZY_API_SERVER_URL, APP_LOGO_URL and
# MAIN_PICTURE* are allowed automatically). Entry formats:
# - host, *.host (subdomains only, not host itself) or host:port: https only, e.g. cdn.example.com
# - a full origin http(s)://host[:port]: exactly that origin; use it for http or a custom port,
#   e.g. http://minio.lan:9000
# Hosts outside the list the image was built with (the built-in defaults) are served unoptimized: /_next/image
# redirects (307) the browser to the original image. Hosts in the built-in list always go through the optimizer.
NEXT_PUBLIC_IMAGES_HOSTS=

# ============================================
# OPTIONAL - CALLBACK URLS (server only)
# ============================================
# Leave both empty unless the emails must link to another host: a value overrides the link for every user.
# Invitation email link, read by the server routes that send team invitations
# (empty = this app's origin + /auth/accept-invite)
INVITE_CALLBACK_URL=
# Email verification link, read by the server when it registers a user (/api/auth/register) and when it resends
# the verification link (/api/auth/verify/resend-link) (empty = this app's origin + /verify-email)
VERIFY_EMAIL_CALLBACK_URL=

# ============================================
# OPTIONAL - SMTP MAIL CONFIGURATION (server only)
# ============================================
# Custom SMTP server the app passes to the Gauzy API when it sends mail; the sender address must belong to your
# own mail domain, e.g. noreply@example.com
SMTP_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=

# ============================================
# OPTIONAL - SOCIAL LOGIN (OAuth)
# ============================================
# A sign-in button exists only for Google, Facebook, GitHub and Twitter/X, and it is shown only when BOTH:
# - NEXT_PUBLIC_<PROVIDER>_APP_NAME is set. Any value counts, an empty one included, and the image already sets
#   the GOOGLE, FACEBOOK, GITHUB and TWITTER app names to empty, so for these four this is always true;
# - <PROVIDER>_CLIENT_ID and <PROVIDER>_CLIENT_SECRET are set.
# The button label is fixed (the app name is not displayed), and demo mode (NEXT_PUBLIC_DEMO=true) hides the
# buttons. APPLE_, DISCORD_, LINKEDIN_ and SLACK_CLIENT_ID / _CLIENT_SECRET (with the matching
# NEXT_PUBLIC_<PROVIDER>_APP_NAME) are accepted by next-auth but have no sign-in button. MICROSOFT_* is
# currently not picked up at all (provider id mismatch in core/lib/utils/check-provider-env-vars.ts).
# Callback URL to register with each provider: <public origin>/api/auth/callback/<google|github|facebook|twitter>

# Public origin of this app for next-auth, without a path, e.g. https://teams.example.com: the OAuth callback URLs
# are built from it. Needed behind a reverse proxy / ingress that does not forward the public host
# (Host or X-Forwarded-Host) and X-Forwarded-Proto; unset = taken from each request. Leave it commented out
# rather than empty when unused: an empty value would also mask a NEXTAUTH_URL.
# AUTH_URL=https://teams.example.com

# Google
NEXT_PUBLIC_GOOGLE_APP_NAME=ever-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub. NEXT_PUBLIC_GITHUB_APP_NAME is also the slug of the GitHub App behind the GitHub integration
# (Settings > Integrations), which offers no install link until you set it to your own GitHub App's slug.
# Left empty here, it still enables the GitHub sign-in button (see above).
# (Ever-operated: NEXT_PUBLIC_GITHUB_APP_NAME=ever-github)
NEXT_PUBLIC_GITHUB_APP_NAME=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Facebook
NEXT_PUBLIC_FACEBOOK_APP_NAME=ever-facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Twitter / X
NEXT_PUBLIC_TWITTER_APP_NAME=ever-twitter
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# ============================================
# OPTIONAL - MEET CONFIGURATION
# ============================================
# Video meetings provider: 'Jitsi' (default) or 'LiveKit' (case-insensitive)
NEXT_PUBLIC_MEET_TYPE=Jitsi
# Domain of your Jitsi server, e.g. meet.example.com; Jitsi meetings need it and MEET_JWT_APP_SECRET
# (Ever-operated: NEXT_PUBLIC_MEET_DOMAIN=meet.ever.team)
NEXT_PUBLIC_MEET_DOMAIN=
# Jitsi JWT application id (server only)
MEET_JWT_APP_ID=ever_teams
# Jitsi JWT application secret (server only)
MEET_JWT_APP_SECRET=

# LiveKit Configuration (if you use LiveKit instead of Jitsi)
# LiveKit API secret (server only)
LIVEKIT_API_SECRET=
# LiveKit API key (server only)
LIVEKIT_API_KEY=
# LiveKit server URL (wss://...)
NEXT_PUBLIC_LIVEKIT_URL=

# ============================================
# OPTIONAL - BOARD CONFIGURATION
# ============================================
# Collaborative whiteboard: off while NEXT_PUBLIC_BOARD_APP_DOMAIN is empty; sharing a board also needs
# NEXT_PUBLIC_BOARD_BACKEND_POST_URL. Point both at your own whiteboard deployment.
# Whiteboard app URL (Ever-operated: NEXT_PUBLIC_BOARD_APP_DOMAIN=https://board.ever.team)
NEXT_PUBLIC_BOARD_APP_DOMAIN=
# Whiteboard backend endpoint used to share boards
# (Ever-operated: NEXT_PUBLIC_BOARD_BACKEND_POST_URL=https://jsonboard.ever.team/api/v2/post/)
NEXT_PUBLIC_BOARD_BACKEND_POST_URL=
# Firebase config of the whiteboard (JSON)
NEXT_PUBLIC_BOARD_FIREBASE_CONFIG=

# ============================================
# OPTIONAL - ANALYTICS & TRACKING (sent to the browser)
# ============================================
# Jitsu analytics host
NEXT_PUBLIC_JITSU_BROWSER_URL=
# Jitsu analytics write key
NEXT_PUBLIC_JITSU_BROWSER_WRITE_KEY=
# Jitsu cookie domain
# NEXT_PUBLIC_JITSU_COOKIE_DOMAIN=
# PostHog project key
NEXT_PUBLIC_POSTHOG_KEY=
# PostHog host (default: https://us.i.posthog.com; e.g. https://eu.i.posthog.com or your own PostHog)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ============================================
# OPTIONAL - CHATWOOT (support chat widget)
# ============================================
# Chatwoot website token; empty = no chat widget
NEXT_PUBLIC_CHATWOOT_API_KEY=
# Chatwoot origin, for a self-hosted Chatwoot (default: https://app.chatwoot.com)
# NEXT_PUBLIC_CHATWOOT_BASE_URL=

# ============================================
# OPTIONAL - LOGS CONFIGURATION
# ============================================
# Local log system on/off and max log folder size in MB (the NEXT_PUBLIC_* pair is what the app reads)
LOG_FOLDER_MAX_SIZE=10
NEXT_PUBLIC_LOG_FOLDER_MAX_SIZE=10
ACTIVE_LOCAL_LOG_SYSTEM=true
NEXT_PUBLIC_ACTIVE_LOCAL_LOG_SYSTEM=true

# ============================================
# OPTIONAL - ADDITIONAL CONFIGURATION
# ============================================
# Demo mode: password login page with one-click demo accounts (default: false). The -dev image and
# docker-compose.build.yml default to true: empty turns it off on the -dev image (docker run), but
# docker-compose.build.yml treats empty as unset, so set false there.
NEXT_PUBLIC_DEMO=
# Demo accounts offered in demo mode: a JSON array of {"type","email","password"} (optional "role" label), one
# account per type, type being SUPER_ADMIN, ADMIN or EMPLOYEE; an invalid value is ignored with a warning
# (default: the accounts of a Gauzy API seeded with the demo data, e.g. admin@ever.co). Sent to the browser: use
# throwaway demo credentials only
# NEXT_PUBLIC_DEMO_ACCOUNTS=[{"type":"ADMIN","email":"demo@example.com","password":"demo-password"}]
# Disable the periodic data auto-refresh (default: false)
NEXT_PUBLIC_DISABLE_AUTO_REFRESH=false
# Desktop (Electron) server mode; leave empty for Docker
IS_DESKTOP_APP=

# ============================================
# OPTIONAL - MAILCHIMP (newsletter subscribe endpoint, server only)
# ============================================
MAILCHIMP_API_KEY=
MAILCHIMP_LIST_ID=

# ============================================
# SENTRY CONFIGURATION
# ============================================
# Error reporting, read at runtime; empty = off. SENTRY_DSN: server errors, NEXT_PUBLIC_SENTRY_DSN: browser errors
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Sentry client debug logging
NEXT_PUBLIC_SENTRY_DEBUG=false
# Optional, read at runtime: SENTRY_ENVIRONMENT / SENTRY_RELEASE / SENTRY_TRACES_SAMPLE_RATE (server) and
# NEXT_PUBLIC_SENTRY_ENVIRONMENT / NEXT_PUBLIC_SENTRY_RELEASE / NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE (browser)
# Build-time only (source map upload when building with SENTRY_DSN set): no effect on the prebuilt image
SENTRY_ORG=ever-co
SENTRY_PROJECT=ever-teams-web
SENTRY_AUTH_TOKEN=
# Not read by the web app
SENTRY_LOG_LEVEL=info

# ============================================
# NOT READ BY THE PREBUILT IMAGE (kept for compatibility)
# ============================================
# Build-time only settings (used when building the image, e.g. docker-compose.build.yml)
NEXT_IGNORE_ESLINT_ERROR_ON_BUILD=true
ANALYZE=false
RECOIL_DUPLICATE_ATOM_KEY_CHECKING_ENABLED=false

# Legacy variables the web app does not read
JITSU_SERVER_URL=
JITSU_SERVER_WRITE_KEY=
POSTMARK_SERVER_API_TOKEN=
# Google Analytics measurement id: no effect, the gtag snippet that used it is commented out
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Cookie domains: no effect, the app sets host-only cookies (no Domain attribute)
NEXT_PUBLIC_COOKIE_DOMAINS=
